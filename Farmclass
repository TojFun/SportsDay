Farm farm;

void setup() {
  size(1200, 600);
  farm = new Farm(width /2, height/2);
}

void draw() {
  background(135, 206, 235);
  farm.display();
  farm.carrot();
}

class Farm {
  int x ;
  int y ;
  color brown = color(140, 90, 40);
  color darkbrown = color(120, 80, 30);

  Farm(int xInit, int yInit) {
    x = xInit;
    y = yInit;
  }

  void display() {
    rectMode(CENTER) ;
    fill(darkbrown);
    rect(x,y, 440, 440, 10) ;
    fill(brown);
    noStroke();
    rect(x, y, 400, 400, 10);
  }

   void carrot() {
    float rowY = y - 150;   

    drawCarrot(x - 100, rowY);
    drawCarrot(x + 100, rowY);
    drawCarrot(x - 100, rowY+160);    
    drawCarrot(x + 100, rowY+160);
  }

  void drawCarrot(float cx, float cy) {
    float s = 2;   // size factor 1 = original 
    noStroke();

    // orange part
    fill(250, 120, 20);
    ellipse(cx, cy + 40*s, 50*s, 80*s);

    fill(20, 240, 20);

    // left leaf
    pushMatrix();
    translate(cx - 10*s, cy);
    rotate(-0.4);
    ellipse(0, 0, 20*s, 40*s);
    popMatrix();

    // middle leaf
    ellipse(cx, cy, 20*s, 40*s);

    // right leaf
    pushMatrix();
    translate(cx + 10*s, cy);
    rotate(0.4);
    ellipse(0, 0, 20*s, 40*s);
    popMatrix();
  }
}
